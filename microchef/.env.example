# ===== In locale =====
# Database SQLite locale
DATABASE_URL="file:./dev.db"

# ===== Online (Vercel) =====
# Password unica per entrare nell'app (se vuota, l'app è aperta: va bene solo in locale)
APP_PASSWORD=
# Database Turso (se impostato, sostituisce il file SQLite locale)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== Facoltativo: funzioni con Claude (a pagamento) =====
# Chiave API di Anthropic: resta sul server, non viene mai inviata al browser.
ANTHROPIC_API_KEY=
# Modello usato per estrazione e adattamento (deve supportare la lettura di immagini e PDF).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Livello di ragionamento: low | medium | high
ANTHROPIC_EFFORT=medium
