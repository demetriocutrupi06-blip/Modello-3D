# Chiave API di Anthropic: resta sul server, non viene mai inviata al browser.
ANTHROPIC_API_KEY=
# Modello usato per estrazione e adattamento (deve supportare la lettura di immagini e PDF).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Livello di ragionamento: low | medium | high
ANTHROPIC_EFFORT=medium
# Database SQLite locale
DATABASE_URL="file:./dev.db"
